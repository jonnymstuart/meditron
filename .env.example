# Framer Server API (project settings → API Keys)
FRAMER_API_KEY=
FRAMER_PROJECT_URL=https://framer.com/projects/xxxx--yyyy

# Google Search Console (service-account JSON, shared with the GSC property)
GSC_SERVICE_ACCOUNT_JSON=./secrets/gsc-sa.json
GSC_SITE_URL=sc-domain:meditron.ch

# Reporting
CLIENT_REPORT_TO=
CLIENT_REPORT_CC=
